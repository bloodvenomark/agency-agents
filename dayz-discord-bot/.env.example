# Discord: Bot-Token aus dem Discord Developer Portal
DISCORD_TOKEN=
# ID deines Discord-Servers (Rechtsklick auf Server -> ID kopieren)
GUILD_ID=
# Name der Discord-Rolle, die Admin-Befehle nutzen darf
ADMIN_ROLE=DayZ Admin

# Nitrado: Long-Life-Token (https://server.nitrado.net/deu/developer/tokens)
NITRADO_TOKEN=
# Service-ID deines DayZ-Servers (steht in der URL im Nitrado-Webinterface)
NITRADO_SERVICE_ID=

# Missionsordner der Karte (Chernarus: dayzOffline.chernarusplus,
# Livonia: dayzOffline.enoch, Sakhal: dayzOffline.sakhal, Nasdara: dayzOffline.nasdara)
MISSION=dayzOffline.nasdara

# Optional: Pfade manuell setzen, falls die Automatik sie nicht findet
# (im Nitrado-Dateibrowser nachsehen)
# MISSION_DIR=/games/ni1234567_1/noftp/dayzps/mpmissions/dayzOffline.chernarusplus/
# ADM_LOG_DIR=/games/ni1234567_1/noftp/dayzps/config/

# Wirtschaft
START_GELD=500
TAEGLICH_BONUS=250
KILL_BELOHNUNG=100
WAEHRUNG=Rubel

# true = Server wird nach jedem Kauf sofort neu gestartet (Lieferung sofort)
# false = Lieferung beim nächsten geplanten Neustart
NEUSTART_NACH_KAUF=false

# Discord-Kanäle: Der Bot erstellt sie beim ersten Start automatisch
# (Kategorie "🧟 DayZ" mit shop, killfeed, hitfeed, kopfgeld, airdrops + Admin-Rolle).
KANAELE_AUTOMATISCH=true
KATEGORIE=🧟 DayZ
# Hitfeed komplett ausschalten (kann auf vollen Servern viel werden)
HITFEED_AN=true
# Optional: eigene, schon vorhandene Kanäle nutzen (Rechtsklick -> ID kopieren)
KILLFEED_KANAL=
HITFEED_KANAL=
KOPFGELD_KANAL=
LOOTDROP_KANAL=

# Zusatz-Belohnung pro 100 m Kill-Distanz (0 = aus)
KILL_BONUS_PRO_100M=25

# Kopfgeld
KOPFGELD_MINIMUM=100
# Automatisches Kopfgeld ab dieser Killserie (0 = aus)
AUTO_KOPFGELD_AB_SERIE=5
AUTO_KOPFGELD_START=500
AUTO_KOPFGELD_PRO_KILL=100
# Ungefähren Standort (± 100 m) bei Kopfgeld-Ankündigung zeigen
KOPFGELD_STANDORT_ZEIGEN=true

# Safezone: Mitte (x/z) und Radius in Metern, auch per /admin-safezone änderbar.
# Wer dort einen Spieler tötet, wird automatisch gebannt (Notwehr ausgenommen).
# Moschee-Safezone südlich von Bam-e Sabz:
SAFEZONE_X=8700
SAFEZONE_Z=8264
SAFEZONE_RADIUS=75
SAFEZONE_BANN_TAGE=30

# Bauverbotszone: dort dürfen nur Spieler mit TRADER_ROLE oder ADMIN_ROLE bauen/platzieren.
# Andere werden im Admin-Kanal gemeldet und per DM verwarnt (Spieler muss verknüpft sein).
TRADER_ROLE=Trader
BAUVERBOT_X=8700
BAUVERBOT_Z=8264
BAUVERBOT_RADIUS=150
# Bann in Tagen bei Verstoß (0 = nur verwarnen und melden)
BAUVERBOT_BANN_TAGE=0

# Trader-Läden (trader_laeden.json): nur die eigene Rolle ("Trader 1" ... "Trader 6") und Admins
# dürfen den Laden betreten. Fremde werden gemeldet; Bann in Tagen (0 = nur verwarnen und melden)
LADEN_BANN_TAGE=0
