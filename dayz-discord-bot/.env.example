# Discord: Bot-Token aus dem Discord Developer Portal
DISCORD_TOKEN=
# ID deines Discord-Servers (Rechtsklick auf Server -> ID kopieren)
GUILD_ID=
# Name der Discord-Rolle, die Admin-Befehle nutzen darf
ADMIN_ROLE=DayZ Admin

# Nitrado: Long-Life-Token (https://server.nitrado.net/deu/developer/tokens)
NITRADO_TOKEN=
# Service-ID deines DayZ-Servers (steht in der URL im Nitrado-Webinterface)
NITRADO_SERVICE_ID=

# Missionsordner der Karte (Chernarus: dayzOffline.chernarusplus,
# Livonia: dayzOffline.enoch, Sakhal: dayzOffline.sakhal)
MISSION=dayzOffline.chernarusplus

# Optional: Pfade manuell setzen, falls die Automatik sie nicht findet
# (im Nitrado-Dateibrowser nachsehen)
# MISSION_DIR=/games/ni1234567_1/noftp/dayzps/mpmissions/dayzOffline.chernarusplus/
# ADM_LOG_DIR=/games/ni1234567_1/noftp/dayzps/config/

# Wirtschaft
START_GELD=500
TAEGLICH_BONUS=250
KILL_BELOHNUNG=100
WAEHRUNG=Rubel

# true = Server wird nach jedem Kauf sofort neu gestartet (Lieferung sofort)
# false = Lieferung beim nächsten geplanten Neustart
NEUSTART_NACH_KAUF=false
